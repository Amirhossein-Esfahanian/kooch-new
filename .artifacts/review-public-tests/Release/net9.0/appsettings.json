{
  "ConnectionStrings": {
    "DefaultConnection": "Server=.;Database=KoochDb;Trusted_Connection=True;TrustServerCertificate=True"
  },
  "ReviewInvitations": {
    "PermanentOptOutEnabled": false
  },
  "AutomaticDatabaseMutations": {
    "Enabled": true
  },
  "Jwt": {
    "Key": "development-only-kooch-jwt-key-change-in-production",
    "Issuer": "Kooch.Api",
    "Audience": "Kooch.Client",
    "ExpiresMinutes": 60,
    "AccessTokenExpirationDays": 30
  },
  "HolidayCalendar": {
    "Synchronization": {
      "Enabled": false,
      "RunOnStartup": true,
      "StartupDelaySeconds": 10,
      "InitialYearsAhead": 2,
      "SyncDayOfMonth": 1,
      "SyncHourLocal": 3,
      "SyncMinuteLocal": 0,
      "IranTimeZoneId": "Iran Standard Time",
      "ProviderName": "PNLdev",
      "MaximumEventTitleLength": 512
    }
  },
  "Weather": {
    "Enabled": true,
    "Provider": "VisualCrossing",
    "LocationKey": "kashan",
    "Location": "Kashan,Iran",
    "ForecastDays": 15,
    "DisplayDays": 7,
    "RefreshMinutes": 180,
    "UnitGroup": "metric",
    "Language": "fa",
    "TimeoutSeconds": 15,
    "RetryCount": 2,
    "LeaseSeconds": 120,
    "StartupDelaySeconds": 10
  },
  "PaymentProviders": {
    "InternalTest": {
      "Enabled": false
    }
  },
  "MediaStorage": {
    "RootPath": "../../storage/uploads",
    "PublicBasePath": "/uploads",
    "StagingLifetimeHours": 24
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
