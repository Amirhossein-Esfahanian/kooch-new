KOOCH_BACKEND_ORIGIN=http://localhost:5081
NEXT_PUBLIC_INTERNAL_TEST_PAYMENTS_ENABLED=true

# Public frontend HTTP(S) origin only (no path, query, credentials or fragment).
# Required for Owner public booking links; no current-origin/backend fallback.
# Use HTTPS for non-local production destinations. Set the real deployment origin.
# NEXT_PUBLIC values are embedded at build time: rebuild/redeploy after changing.
NEXT_PUBLIC_KOOCH_PUBLIC_ORIGIN=
