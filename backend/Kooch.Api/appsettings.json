{
  "ConnectionStrings": {
    "DefaultConnection": "Server=.;Database=KoochDb;Trusted_Connection=True;TrustServerCertificate=True"
  },
  "Jwt": {
    "Key": "development-only-kooch-jwt-key-change-in-production",
    "Issuer": "Kooch.Api",
    "Audience": "Kooch.Client",
    "ExpiresMinutes": 60,
    "AccessTokenExpirationDays": 30
  },
  "HolidayCalendar": {
    "Synchronization": {
      "Enabled": false,
      "RunOnStartup": true,
      "StartupDelaySeconds": 10,
      "InitialYearsAhead": 2,
      "SyncDayOfMonth": 1,
      "SyncHourLocal": 3,
      "SyncMinuteLocal": 0,
      "IranTimeZoneId": "Iran Standard Time",
      "ProviderName": "PNLdev",
      "MaximumEventTitleLength": 512
    }
  },
  "PaymentProviders": {
    "InternalTest": {
      "Enabled": false
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
